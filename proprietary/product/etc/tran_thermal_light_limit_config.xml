<!--
package: com.foo

level1:
    param1: the first threshold of temperature rise
    param2: hysteresis temperature of param1 when temperature down
    param3: brightness ratio when temperature over the first threshold
    param4: luxlimit. the threshold value of ambient light intensity, when
             the ambient lux is lower than it, it is indoors.(0: invalid)

level2:
    param1: the second threshold of temperature rise
    param2: hysteresis temperature of param1 when temperature down
    param3: brightness ratio when temperature over the second threshold
    param4: luxlimit. the threshold value of ambient light intensity, when
             the ambient lux is lower than it, it is indoors.(0: invalid)

level3:
    param1: the second threshold of temperature rise
    param2: hysteresis temperature of param1 when temperature down
    param3: brightness ratio when temperature over the second threshold
    param4: luxlimit. the threshold value of ambient light intensity, when
             the ambient lux is lower than it, it is indoors.(0: invalid)

white_list_config_autolight_on:
    Parameters currently expected to take effect when the user turns on automatic backlighting

white_list_config_auto_light_off:
    Parameters currently expected to take effect when the user turns on manual backlighting
-->
<packages>
	<!--<black_list_config package="com.transsion.XOSLauncher"/>-->
	<white_list_config_autolight_on package="^.*$" level1="43,41,80,2000" level2="46,44,65,2000" level3="49,47,50,2000"/>                         <!--Common AutoLight-->
	<white_list_config_auto_light_off package="^.*$" level1="45,43,85,0" level2="49,47,75,0"/>                         <!--Common ManualLight-->
