type hal_gatekeeper_default, domain;
hal_server_domain(hal_gatekeeper_default, hal_gatekeeper)

binder_use(hal_gatekeeper_default)
hal_gatekeeper_binder_calls(hal_gatekeeper_default)

allow hal_gatekeeper_default system_data_file:file { read open };
allow hal_gatekeeper_default system_data_file:dir { search read open };

allow hal_gatekeeper_default mnt_user_file:file { read open };
allow hal_gatekeeper_default mnt_user_file:dir { search read open };

allow hal_gatekeeper_default vendor_data_file:file { read open create write ioctl };
allow hal_gatekeeper_default vendor_data_file:dir { search read open create write ioctl };

allow hal_gatekeeper_default default_prop:file { read open };
