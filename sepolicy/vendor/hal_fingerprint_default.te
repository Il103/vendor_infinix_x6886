type hal_fingerprint_default, domain;
hal_server_domain(hal_fingerprint_default, hal_fingerprint)

binder_use(hal_fingerprint_default)
hal_fingerprint_binder_calls(hal_fingerprint_default)

allow hal_fingerprint_default system_data_file:file { read open };
allow hal_fingerprint_default system_data_file:dir { search read open };

allow hal_fingerprint_default mnt_user_file:file { read open };
allow hal_fingerprint_default mnt_user_file:dir { search read open };

allow hal_fingerprint_default vendor_data_file:file { read open create write ioctl };
allow hal_fingerprint_default vendor_data_file:dir { search read open create write ioctl };

allow hal_fingerprint_default default_prop:file { read open };
