type hal_sensors_default, domain;
hal_server_domain(hal_sensors_default, hal_sensors)

binder_use(hal_sensors_default)
hal_sensors_binder_calls(hal_sensors_default)

allow hal_sensors_default system_data_file:file { read open };
allow hal_sensors_default system_data_file:dir { search read open };

allow hal_sensors_default mnt_user_file:file { read open };
allow hal_sensors_default mnt_user_file:dir { search read open };

allow hal_sensors_default vendor_data_file:file { read open create write ioctl };
allow hal_sensors_default vendor_data_file:dir { search read open create write ioctl };

allow hal_sensors_default sensors_device:chr_file { read write ioctl open };
allow hal_sensors_default sensors_device:dir { search read open };

allow hal_sensors_default default_prop:file { read open };
