type hal_camera_default, domain;
hal_server_domain(hal_camera_default, hal_camera)

binder_use(hal_camera_default)
hal_camera_binder_calls(hal_camera_default)

allow hal_camera_default system_data_file:file { read open };
allow hal_camera_default system_data_file:dir { search read open };

allow hal_camera_default mnt_user_file:file { read open };
allow hal_camera_default mnt_user_file:dir { search read open };

allow hal_camera_default vendor_data_file:file { read open create write ioctl };
allow hal_camera_default vendor_data_file:dir { search read open create write ioctl };

allow hal_camera_default camera_device:chr_file { read write ioctl open };
allow hal_camera_default camera_device:dir { search read open };

allow hal_camera_default default_prop:file { read open };
